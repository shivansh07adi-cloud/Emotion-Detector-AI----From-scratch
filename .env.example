# Copy to .env (or set these in your host's dashboard). Never commit real values.

# Required in production: signs the visitor cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Razorpay (Dashboard > Account & Settings > API Keys). Use test keys first.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Optional: plan settings (defaults shown)
FREE_DAILY_LIMIT=10
FREE_MAX_CHARS=500
PRO_MAX_CHARS=5000
PRO_PRICE_INR=149
PRO_DAYS=30

# Optional: force quotas and payments on (1) or off (0). Default: on, except on Vercel.
MONETIZATION_ENABLED=

# Optional: use a model file from somewhere else (default: EmotionDetection/model.json)
MODEL_PATH=

# Optional: hosting
DATABASE_PATH=emotion_detector.db
TRUST_PROXY=0          # set to 1 behind nginx / a platform proxy so IPs are read correctly
SESSION_COOKIE_SECURE=0  # set to 1 once the site is served over HTTPS
